# Server
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/workspace.db

# Auth
JWT_SECRET=change-me-to-a-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_API_KEY=ctw-dev-key-change-me

# External services (Docker)
AGENT_MAIL_URL=http://127.0.0.1:8765/mcp/
MCP_AGENT_MAIL_TOKEN=change-me
CM_URL=http://127.0.0.1:9900

# Agent Session (used by Claude Code agent sessions to call server APIs)
CTW_SERVER_URL=http://localhost:3000
CTW_API_KEY=ctw-dev-key-change-me
CTW_PROJECT_ID=proj_default

# Bot user API key (for background/system agent tasks)
CTW_BOT_API_KEY=ctw-bot-change-me

# Project
PROJECT_ROOT=/data/projects/myapp
