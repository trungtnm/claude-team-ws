# ─── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/workspace.db

# ─── Auth ──────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
# Seed admin user (only used on first run)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_API_KEY=ctw-dev-key-change-me

# ─── Claude CLI ────────────────────────────────
# If not using claude auth login
# ANTHROPIC_AUTH_TOKEN=sk-ant-...
DEFAULT_MODEL=sonnet

# ─── Agent Mail (Docker) ──────────────────────
AGENT_MAIL_URL=http://127.0.0.1:8765/mcp/
MCP_AGENT_MAIL_TOKEN=change-me-to-random-token

# ─── CM Memory (Docker) ───────────────────────
CM_URL=http://127.0.0.1:9900
ANTHROPIC_API_KEY=sk-ant-...

# ─── Project ──────────────────────────────────
# Path to project root (where .beads/ and repos/ live)
PROJECT_ROOT=/data/projects/myapp

# ─── Webhooks (optional) ──────────────────────
# SLACK_DEFAULT_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/...
